{
	"name": "MegaBox",
	"version": "2.2.17",
	"description": "MegaBox is an advanced online and offline chiptune tracker.",
	"author": "Main",
	"contributors": [
		"Neputendo",
		"LeoV",
		"Mid",
		"choptop84",
		"Slarmoo"
	],
	"license": "MIT",
	"homepage": "https://ultraabox.github.io",
	"type": "module",
	"main": "main.js",
	"icon": "path.join(__dirname, 'icon.ico')",
	"scripts": {
		"build": "node ./build/build.js all",
		"build-synth": "node ./build/build.js synth",
		"build-player": "node ./build/build.js player",
		"build-editor": "node ./build/build.js editor",
		"build-offline-html": "node ./build/build.js build-offline-html",
		"dev": "node ./build/build.js watch",
		"watch": "node ./build/build.js watch",
		"typecheck": "node ./build/build.js typecheck",
		"optimize-samples": "node ./build/convert_samples.js",
		"build-offline": "bash ./compile_beepbox_offline.sh",
		"deploy-files": "bash ./deploy_files.sh",
		"start": "electron ./to_deploy",
		"package": "electron-packager ./to_deploy --platform=darwin,linux,win32 --arch=ia32,x64 --asar --overwrite && npm run build-offline-html",
		"package-macos": "electron-packager ./to_deploy --platform=darwin --arch=arm64 --asar --overwrite && npm run build-offline-html",
		"package-host": "electron-packager ./to_deploy UltraBox --asar --overwrite && npm run build-offline-html"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ultraabox/ultrabox_typescript.git"
	},
	"devDependencies": {
		"@electron/packager": "^18.3.5",
		"@rollup/plugin-node-resolve": "^15.1.0",
		"@types/node": "^26.4.1",
		"electron": "^33.4.11",
		"rollup": "^2.79.1",
		"rollup-plugin-sourcemaps": "^0.6.3",
		"terser": "^5.19.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@types/jquery": "^3.5.5",
		"@types/select2": "^4.0.53",
		"imperative-html": "^0.1.0",
		"select2": "^4.0.13"
	},
	"allowScripts": {
		"electron@33.0.0": true
	}
}
